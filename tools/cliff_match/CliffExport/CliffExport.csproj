<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the GLB of a slab-cliff settings file, for the matching harness (run_match.sh). Not part of the solution or any test project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/PropGenerator.Nature/PropGenerator.Nature.csproj" />
  </ItemGroup>
</Project>
