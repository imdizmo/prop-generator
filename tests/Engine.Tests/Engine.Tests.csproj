<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine's tests: the host (threads, queue, cancel, heap caps, DTOs) against a stand-in bundle in Fixtures/,
       and easy-props' own bundle when it is embedded. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>PropGenerator.Engine.Tests</RootNamespace>
    <!-- Test methods need no doc comment: their names say what they check. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- A stuck test is dumped and stopped after 5 minutes (testconfig.json). -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --config-file $(MSBuildThisFileDirectory)../testconfig.json</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PropGenerator.Engine/PropGenerator.Engine.csproj" />
  </ItemGroup>
</Project>
